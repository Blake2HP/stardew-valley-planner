# 复制为 .env 后填写
LLM_PROVIDER=anthropic          # anthropic / openai / mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 以下可选，括号里是默认值
# ANTHROPIC_EFFORT=medium        # 思考力度：low / medium / high / xhigh / max
# ANTHROPIC_MAX_TOKENS=16000     # 含思考 token
# ANTHROPIC_TIMEOUT=300          # 单次请求超时（秒）
# ANTHROPIC_MAX_RETRIES=1        # SDK 自动重试次数
# ANTHROPIC_FALLBACKS=on         # 拒答时服务端自动换模型；off 关闭
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
